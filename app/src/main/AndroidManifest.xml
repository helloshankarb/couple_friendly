<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions for AI Flirting Assistant -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/custom_app_icon"
        android:label="@string/app_name"
        android:roundIcon="@drawable/custom_app_icon"
        android:supportsRtl="true"
        android:theme="@style/Theme.Couplefriendly">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Couplefriendly">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Floating overlay service (no AccessibilityService — uses SYSTEM_ALERT_WINDOW only) -->
        <service
            android:name=".FloatingOverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse" />
    </application>

</manifest>